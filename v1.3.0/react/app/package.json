{
	"name": "m3a-react",
	"version": "1.3.0",
	"description": "Fully responsive admin template built with React, Tailwind CSS and shadcn/ui",
	"private": true,
	"type": "module",
	"author": "avidtemplates.com",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\""
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie > 0"
	],
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
